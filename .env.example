# Production (App Runner, Fargate, or any host in front of RDS).
# Leave DATABASE_URL unset locally and use `npm run dev`.
DATABASE_URL=postgres://stockist:stockist@your-rds-host:5432/stockist?sslmode=require
SESSION_SECRET=replace-with-at-least-32-random-characters
RETAILER_PASSWORD=replace-with-8-or-more
BRAND_PASSWORD=replace-with-8-or-more
PORT=8787
TRUST_PROXY=true
# CORS_ORIGIN=https://your-frontend.example
